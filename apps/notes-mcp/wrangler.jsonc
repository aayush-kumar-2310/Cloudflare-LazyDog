{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lazydog-notes-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No per-version public preview URLs.
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "NOTES_DB",
      "database_name": "lazydog-notes",
      "database_id": "56cd93e7-9a5e-43c5-88dd-79f0b1b24fdb",
      "migrations_dir": "migrations"
    }
  ]
  // Secret: NOTES_MCP_SECRET (shared with the LazyDog Worker) — `wrangler secret put NOTES_MCP_SECRET`
}
